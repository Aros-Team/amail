# ---------------------------------------------------------------------------
# Amail - environment configuration
# Copy this file to `.env` and adjust the values. It is loaded automatically
# from the project directory (see app/config/settings.py).
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------

# API key for protecting send endpoints (POST /api/v1/send, /api/v1/send/batch).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Leave empty to disable auth (development mode).
# In production, store in a secret manager and set via env var.
AMAIL_API_KEY=

# ---------------------------------------------------------------------------
# Resend (email sending and receiving provider)
# ---------------------------------------------------------------------------

# Resend API key (dashboard.resend.com/api-keys).
# Used to send emails and to fetch the content of inbound emails.
# Starts with "re_". Leave empty if testing with EMAIL_PROVIDER=mock.
RESEND_API_KEY=re_123456789

# Resend webhook signing secret (inbound receiver webhook "whsec_").
# Used to verify the Svix signature of `email.received` events.
# Keep it secret. Must match the one configured in Resend.
RESEND_WEBHOOK_SECRET=whsec_your_secret_here

# Admin address for batch failure reports. On POST /api/v1/send/batch, if any
# email fails and this is set, a failure report is sent to it.
ADMIN_EMAIL=admin@example.com

# ---------------------------------------------------------------------------
# Provider and environment
# ---------------------------------------------------------------------------

# Active email provider. Values: "resend" (production) or "mock"
# (local/testing, makes no network calls).
EMAIL_PROVIDER=resend

# Deployment environment. Informational only.
ENVIRONMENT=development

# structlog log level: DEBUG, INFO, WARNING, ERROR, CRITICAL.
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Inbound routing contract
# ---------------------------------------------------------------------------
# Inbound forwarding is driven by a declarative YAML routing contract, not
# individual env vars. Sources in order:
#   1. AMAIL_ROUTES      - the YAML content as an env var / secret.
#   2. AMAIL_ROUTES_FILE - path to a YAML file.
#   3. config/amail.yaml - development file (gitignored).
# This contract sets the email `domain`, the accepted inbound addresses, and
# where each is forwarded. See config/amail.example.yaml for a template.
# Note: these are commented out by default. Uncomment and set ONE of them, or
# create config/amail.yaml for local dev.
#
# AMAIL_ROUTES=domain: example.com
# AMAIL_ROUTES_FILE=/etc/amail/routes.yaml