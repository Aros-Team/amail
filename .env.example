# Resend API Key (required)
# Get your key from https://resend.com
RESEND_API_KEY=re_123456789

# Resend Webhook Secret (required for receiving emails)
# Get it from Resend dashboard -> Webhooks -> your webhook
RESEND_WEBHOOK_SECRET=whsec_your_secret_here

# Email domain (optional, default: aros.services)
DOMAIN=aros.services

# Email to forward webhook emails to (optional)
FORWARD_TO_EMAIL=your-email@example.com
